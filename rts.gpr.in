library project RTS is
   type Arch_Name is (
      "riscv64-limine",
      "x86_64-limine"
   );

   type Proving_State is ("false", "true");

   Arch : Arch_Name := "@host_cpu@-@PLATFORM@";
   Proving : Proving_State := external ("IRONCLAD_PROVING", "false");
   Ada_Flags        := "@ADAFLAGS@";

   for Source_Dirs use ("rtsdir/adainclude");
   for Object_Dir use "rtsdir/obj";
   for Library_Dir use "rtsdir/adalib";
   for Library_Kind use "static";
   for Library_Name use "gnat";
   for Languages use ("Ada");
   for Create_Missing_Dirs use "True";

   package Builder is
      for Global_Configuration_Pragmas use "@SRCDIR@/source/pragmas.adc";
      for Switches ("Ada") use ("-nostdlib");

      --  gnatprove analyzes with a compiler of its own, built for the host,
      --  so it gets told the target properties of the one we build with.
      case Proving is
         when "true" =>
            for Global_Compilation_Switches ("Ada") use
              ("-gnateT=" & "@BUILDDIR@" & "/target.atp");
         when "false" =>
            null;
      end case;
   end Builder;

   package Compiler is
      Base_Ada_Switches := Split (Ada_Flags, " ") & (
         "-Wall",
         "-Wextra",
         "@WERROR_FLAG@",
         "-gnaty",
         "-gnatg",
         "-nostdinc",
         "-fno-stack-protector",
         "-fno-stack-check",
         "-fno-stack-clash-protection",
         "-fno-PIC",
         "-ffunction-sections",
         "-fdata-sections",
         "-ffile-prefix-map=" & "@SRCDIR@" & "=.",
         "-ffile-prefix-map=" & "@BUILDDIR@" & "=.",
         "-gno-record-gcc-switches"
      );

      case Arch is
         when "riscv64-limine" =>
            --  Unlike on x86_64, control-flow protection is not used, and a
            --  toolchain enabling it by default would reject the -march below.
            Base_Ada_Switches := Base_Ada_Switches & (
               "-fcf-protection=none",
               "-march=rv64imac_zicsr_zifencei",
               "-mabi=lp64",
               "-mcmodel=medlow"
            );
         when "x86_64-limine" =>
            Base_Ada_Switches := Base_Ada_Switches & (
               "-fcf-protection",
               "-m64",
               "-march=x86-64",
               "-mgeneral-regs-only",
               "-mno-red-zone",
               "-mcmodel=kernel"
            );
      end case;

      for Switches ("Ada") use Base_Ada_Switches;
   end Compiler;
end RTS;
