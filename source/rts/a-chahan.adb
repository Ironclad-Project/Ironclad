package body Ada.Characters.Handling with Pure is
   function To_Upper (C : Character) return Character is
   begin
      if C in 'a' .. 'z' then
         return Character'Val (Character'Pos (C) - 32);
      else
         return C;
      end if;
   end To_Upper;
end Ada.Characters.Handling;
