project Ironclad is
   type Arch_Name is (
      "riscv64-limine",
      "x86_64-limine"
   );

   type Proving_State is ("false", "true");
   type Linker_No_PIE_State is ("false", "true");
   type Linker_No_Relax_GP_State is ("false", "true");

   Arch : Arch_Name := "@host_cpu@-@PLATFORM@";
   Proving : Proving_State := external ("IRONCLAD_PROVING", "false");
   Linker_No_PIE : Linker_No_PIE_State := "@LD_HAS_NO_PIE@";
   Linker_No_Relax_GP : Linker_No_Relax_GP_State := "@LD_HAS_NO_RELAX_GP@";
   Ada_Flags        := "@ADAFLAGS@";
   C_Flags          := "@CFLAGS@";
   Asm_Flags        := "@ASFLAGS@";
   Linker_Flags     := "@LDFLAGS@";

   Common_Source_Dirs := (
      "@SRCDIR@/source/arch",
      "@SRCDIR@/source/cryptography",
      "@SRCDIR@/source/devices/pci",
      "@SRCDIR@/source/devices",
      "@SRCDIR@/source/ipc",
      "@SRCDIR@/source/memory",
      "@SRCDIR@/source/networking",
      "@SRCDIR@/source/sound",
      "@SRCDIR@/source/userland",
      "@SRCDIR@/source/vfs",
      "@SRCDIR@/source/virtualization",
      "@SRCDIR@/source",
      "@SRCDIR@/freestanding-c-hdrs/include",
      "@SRCDIR@/cc-runtime/src"
   );

   case Arch is
      when "riscv64-limine" =>
         Common_Source_Dirs := Common_Source_Dirs & (
            "@SRCDIR@/source/arch/riscv64-limine/devices",
            "@SRCDIR@/source/arch/riscv64-limine",
            "@SRCDIR@/uacpi/source",
            "@SRCDIR@/flanterm/src",
            "@SRCDIR@/flanterm/src/flanterm_backends"
         );
      when "x86_64-limine" =>
         Common_Source_Dirs := Common_Source_Dirs & (
            "@SRCDIR@/source/arch/x86_64-limine/devices",
            "@SRCDIR@/source/arch/x86_64-limine/virtualization",
            "@SRCDIR@/source/arch/x86_64-limine",
            "@SRCDIR@/uacpi/source",
            "@SRCDIR@/flanterm/src",
            "@SRCDIR@/flanterm/src/flanterm_backends"
         );
   end case;

   for Source_Dirs use Common_Source_Dirs;
   for Object_Dir use "obj";
   for Exec_Dir use ".";
   for Main use ("main.adb");
   for Languages use ("Ada", "C", "Asm_Cpp");
   for Create_Missing_Dirs use "True";

   package Builder is
      for Executable ("main.adb") use "ironclad";
      for Switches ("Ada") use ("-nostdlib");

      --  gnatprove analyzes with a compiler of its own, built for the host,
      --  so it gets told the target properties of the one we build with.
      case Proving is
         when "true" =>
            for Global_Compilation_Switches ("Ada") use
              ("-gnateT=" & "@BUILDDIR@" & "/target.atp");
         when "false" =>
            null;
      end case;
   end Builder;

   Common_Compiler_Flags := (
      "-Wall",
      "-Wextra",
      "@WERROR_FLAG@",
      "-nostdinc",
      "-fno-stack-protector",
      "-fno-stack-check",
      "-fno-stack-clash-protection",
      "-fno-PIC",
      "-ffunction-sections",
      "-fdata-sections",
      "-ffile-prefix-map=" & "@SRCDIR@" & "=.",
      "-ffile-prefix-map=" & "@BUILDDIR@" & "=.",
      "-gno-record-gcc-switches"
   );

   case Arch is
      when "riscv64-limine" =>
         --  Unlike on x86_64, control-flow protection is not used, and a
         --  toolchain enabling it by default would reject the -march below.
         Common_Compiler_Flags := Common_Compiler_Flags & (
            "-fcf-protection=none",
            "-march=rv64imac_zicsr_zifencei",
            "-mabi=lp64",
            "-mcmodel=medlow"
         );
      when "x86_64-limine" =>
         Common_Compiler_Flags := Common_Compiler_Flags & (
            "-fcf-protection",
            "-m64",
            "-march=x86-64",
            "-mgeneral-regs-only",
            "-mno-red-zone",
            "-mcmodel=kernel"
         );
   end case;

   package Compiler is
      Base_Ada_Switches := Split (Ada_Flags, " ") & Common_Compiler_Flags & (
         "-gnaty",
         "-gnateDIroncladName=""" & "@PACKAGE_NAME@"      & """",
         "-gnateDVersion="""      & "@PACKAGE_VERSION@"   & """",
         "-gnateDBugSite="""      & "@PACKAGE_BUGREPORT@" & """",
         "-gnateDArchitecture=""" & "@host_cpu@"          & """",
         "-gnateDPlatform="""     & "@PLATFORM@"          & """",
         "-gnateDArchName="""     & Arch                  & """"
      );
      Base_C_Switches := Split (C_Flags, " ") & Common_Compiler_Flags & (
         "-std=gnu11",
         "-ffreestanding",
         "-I@SRCDIR@/uacpi/include"
      );

      --  GCC before 13 passes the prefix maps on to the assembler only in
      --  this form.
      Base_Asm_Switches := Split (Asm_Flags, " ") & Common_Compiler_Flags & (
         "-fdebug-prefix-map=" & "@SRCDIR@" & "=.",
         "-fdebug-prefix-map=" & "@BUILDDIR@" & "=."
      );

      for Default_Switches ("Ada") use Base_Ada_Switches;
      for Default_Switches ("C") use Base_C_Switches;
      for Default_Switches ("Asm_Cpp") use Base_Asm_Switches;

      --  The compiler runtime has to survive as real object code, as the calls
      --  to it are generated after LTO has already chosen what to keep.
      for Switches ("cc-runtime.c") use Base_C_Switches & ("-fno-lto");
      for Local_Configuration_Pragmas use "@SRCDIR@/source/pragmas.adc";
   end Compiler;

   package Linker is
      --  The kernel needs its runtime and the runtime needs cc-runtime, which
      --  is part of the kernel, so search their archives as a group.
      for Leading_Switches ("Ada") use ("-Wl,--start-group");
      Base_Link_Switches := ("rtsdir/adalib/libgnat.a", "-Wl,--end-group");

      --  Always ask for a build ID, naming its style, as compilers and
      --  linkers differ on both. Comes before LDFLAGS, which can override it.
      Base_Link_Switches := Base_Link_Switches & ("-Wl,--build-id=sha1") &
        Split (Linker_Flags, " ");

      Base_Link_Switches := Base_Link_Switches & Common_Compiler_Flags & (
         "-nostdlib",
         "-static",
         "-no-pie",
         "-Wl,-z,max-page-size=0x1000",
         "-Wl,-z,noexecstack",
         "-Wl,--gc-sections",
         "-T@SRCDIR@/source/arch/" & Arch & "/linker.ld"
      );

      case Arch is
         when "riscv64-limine" =>
            Base_Link_Switches := Base_Link_Switches & (
               "-Wl,-m,elf64lriscv"
            );
         when "x86_64-limine" =>
            Base_Link_Switches := Base_Link_Switches & (
               "-Wl,-m,elf_x86_64"
            );
      end case;

      --  Tell the linker as well, as the compiler does not always pass this
      --  on, if configure found it to have the flag, which GNU ld only has
      --  from 2.37 on.
      case Linker_No_PIE is
         when "true" =>
            Base_Link_Switches := Base_Link_Switches & ("-Wl,-no-pie");
         when "false" =>
            null;
      end case;

      --  Keep riscv64 linker relaxation away from gp, which nothing sets up,
      --  if configure found the linker to have the flag.
      case Linker_No_Relax_GP is
         when "true" =>
            Base_Link_Switches := Base_Link_Switches & ("-Wl,--no-relax-gp");
         when "false" =>
            null;
      end case;

      for Switches ("Ada") use Base_Link_Switches;
   end Linker;
end Ironclad;
